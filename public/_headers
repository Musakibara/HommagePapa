# En-têtes de sécurité appliqués par Netlify (et la plupart des hébergeurs
# statiques) sur toutes les routes. Le site étant 100 % statique (output:
# "export"), c'est ici qu'ils vivent au lieu de next.config.ts.
# Syntaxe Netlify : chaque en-tête sous la règle, indenté de 2 espaces.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https://www.youtube-nocookie.com; img-src 'self' data: blob: https:; media-src 'self' https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https:; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Les assets Next.js sont versionnés : cache long et immuable.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Les images publiques ne sont pas versionnées : cache plus court.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400