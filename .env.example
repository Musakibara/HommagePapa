# =============================================================================
#  Hommage à Papa — variables d'environnement
#  Copiez ce fichier en `.env.local` puis renseignez les valeurs.
# =============================================================================

# -----------------------------------------------------------------------------
# URL publique du site (métadonnées, sitemap, partage, Open Graph).
# Sur Vercel/Netlify, définissez-la sur votre domaine de production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
#  Ce site est 100 % frontend : il n'y a AUCUN backend à configurer.
#  Le livre d'or est stocké dans le navigateur du visiteur (localStorage) et
#  aucune donnée n'est envoyée à un serveur. Aucune clé secrète n'est requise.
# =============================================================================
